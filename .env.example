# PassAudit environment configuration.
# Copy to `.env` (scripts\setup.ps1 / `make setup` do this for you). NEVER commit `.env`.
#
# This file configures running PassAudit directly on your machine (dev servers, the CLI, or
# uvicorn). Docker Compose sets the container values itself in docker-compose.yml and only reads
# these variables from your shell or .env for interpolation: PASSAUDIT_WEB_PORT,
# PASSAUDIT_LOG_LEVEL, PASSAUDIT_RATE_LIMIT_PER_MINUTE, PASSAUDIT_RATE_LIMIT_BURST,
# PASSAUDIT_BATCH_MAX_ITEMS, PASSAUDIT_MAX_CONCURRENT_ANALYSES (docs/docker.md). An empty value
# (`NAME=`) always means "not set".
# PASSAUDIT_WEB_PORT=8080

# --- Backend (prefix PASSAUDIT_) --------------------------------------------
# development | test | production. Production disables the interactive API docs.
PASSAUDIT_ENV=development
# Keep loopback unless you have a reviewed reason to expose the API.
PASSAUDIT_HOST=127.0.0.1
PASSAUDIT_PORT=8000
# critical | error | warning | info | debug
PASSAUDIT_LOG_LEVEL=info
# The API has NO authentication and must stay local. A non-loopback PASSAUDIT_HOST is refused at
# start-up unless this is true - do not enable it without reading docs/security.md.
PASSAUDIT_ALLOW_NON_LOOPBACK_BIND=false
# JSON list of browser origins allowed to call the API. Exact origins only (no "*", no path).
PASSAUDIT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# JSON list of accepted HTTP Host header values (DNS-rebinding defence). Hostnames, no port.
PASSAUDIT_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]

# --- Request limits ---------------------------------------------------------
# Maximum accepted password length (resource-exhaustion guard).
PASSAUDIT_MAX_PASSWORD_LENGTH=1024
# Largest request body for single-password endpoints (bytes).
PASSAUDIT_MAX_BODY_BYTES=65536
# Batch endpoint: passwords per request, and its (larger) body limit in bytes.
PASSAUDIT_BATCH_MAX_ITEMS=50
PASSAUDIT_BATCH_MAX_BODY_BYTES=1048576

# --- Rate limiting (token bucket per client; a batch costs 1 unit per password) ---
PASSAUDIT_RATE_LIMIT_ENABLED=true
PASSAUDIT_RATE_LIMIT_PER_MINUTE=300
# Bucket size. Must be >= PASSAUDIT_BATCH_MAX_ITEMS.
PASSAUDIT_RATE_LIMIT_BURST=100

# --- Analysis concurrency ---------------------------------------------------
PASSAUDIT_MAX_CONCURRENT_ANALYSES=2
# How long a request may wait for a free analysis slot before a 503 (seconds).
PASSAUDIT_ANALYSIS_QUEUE_TIMEOUT_SECONDS=10
# --- Opt-in security features (Phase 8; docs/security.md) -------------------
# The ONLY outbound network call PassAudit can make is the online breach check, and only when
# this is true AND a request asks for it. It sends a 5-character SHA-1 hash prefix, never a
# password or a full hash. Leave false unless you have read docs/security.md ("Breach checking").
PASSAUDIT_EXTERNAL_LOOKUPS_ENABLED=false
# The k-anonymity range endpoint (https only; a self-hosted mirror is fine).
# PASSAUDIT_BREACH_API_URL=https://api.pwnedpasswords.com/range
# PASSAUDIT_BREACH_TIMEOUT_SECONDS=5
# PASSAUDIT_BREACH_BATCH_DEADLINE_SECONDS=20
# A local sorted "SHA1[:count]" file (Pwned Passwords offline format). No network is used.
# PASSAUDIT_BREACH_LOCAL_FILE=
# Authorised reuse auditing: all three must be set together (see docs/security.md). Keep the
# key file apart from the index and protect both like the datasets they were built from.
# PASSAUDIT_REUSE_INDEX_PATH=
# PASSAUDIT_REUSE_KEY_FILE=
# PASSAUDIT_REUSE_AUTHORIZATION_REFERENCE=TICKET-123
# Extra policy profiles (JSON/TOML) and extra dictionary word lists (JSON list of paths).
# PASSAUDIT_POLICY_PROFILES_PATH=
# PASSAUDIT_DICTIONARY_PATHS=[]

# --- Frontend (only VITE_-prefixed values reach the browser; never put secrets here) ---
VITE_API_BASE_URL=/api/v1
